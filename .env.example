# Application
APP_NAME="Construction Internal Portal"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Business policy defaults. Keep USD for existing deployed data.
BUSINESS_CURRENCY=USD
BUSINESS_TIMEZONE=Asia/Qatar
MATERIAL_APPROVAL_THRESHOLD=1000.00

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database
POSTGRES_DB=garrison_portal
POSTGRES_USER=garrison
POSTGRES_PASSWORD=garrison_dev_password
DATABASE_URL=postgresql+asyncpg://garrison:garrison_dev_password@postgres:5432/garrison_portal

# Redis
REDIS_URL=redis://redis:6379/0

# HR and workforce
# Dedicated Fernet key for HR private fields. Supply a real value in protected configuration.
# HR_ENCRYPTION_KEY=
# Optional approved lead time in days for daily in-app HR credential reminders.
# HR_REMINDER_WINDOW_DAYS=
# Elapsed 24-hour days before an unresolved HR service request is overdue. Unset disables it.
# HR_SERVICE_REQUEST_SLA_DAYS=
# HR_PROBATION_REVIEW_REMINDER_DAYS=
# JSON array of approved policy UUIDs explicitly selected for scheduled accrual.
HR_SCHEDULED_LEAVE_POLICY_IDS=[]
HR_LINE_MANAGER_REVIEW_ENABLED=false
HR_SELF_TIME_SUBMISSION_ENABLED=false

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=garrison_minio
MINIO_ROOT_PASSWORD=garrison_minio_password
MINIO_BUCKET=portal-files
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

# JWT signing keys. Required in production/staging: startup fails closed rather than
# falling back to the embedded development key pair.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=24
OTP_EXPIRE_MINUTES=10
ACCOUNT_LOCKOUT_MINUTES=30
AUTH_FAILED_ATTEMPT_LIMIT=3
DEV_EXPOSE_OTP=true
# Staging-only login shortcut for UAT. Ignored unless APP_ENV=staging.
STAGING_LOGIN_OTP=
# Proxies allowed to speak for the client via X-Real-IP / X-Forwarded-For.
# Entries may be single IPs or CIDR subnets. Only list proxies you control: an
# unlisted peer's forwarded headers are ignored and its socket address is used.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Dedicated support ingress is opt-in. Set SUPPORT_INGRESS_PEER to the exact
# private Nginx address only when the reviewed technical virtual host is active.
SUPPORT_PORTAL_ENABLED=false
# Technical sign-in requires a passkey, then an email code. Configure a separate
# random secret of at least 32 bytes and a JSON map of reviewed operator UUIDs
# to dedicated verified mailboxes only in the protected production environment.
# The deployment defaults to paired custody. Select single_owner only for a reviewed initial bootstrap.
# SUPPORT_CUSTODY_MODE=paired
# SUPPORT_EMAIL_OTP_ONLY_LOGIN=false
# SUPPORT_EMAIL_OTP_KEY=
# SUPPORT_EMAIL_OTP_RECIPIENTS={}
# Production assisted business password-recovery delivery remains disabled unless
# explicitly enabled with an independent SUPPORT_RECOVERY_KEY and HTTPS origin allowlist.
SUPPORT_RECOVERY_DELIVERY_ENABLED=false
# SUPPORT_RECOVERY_ALLOWED_ORIGINS=https://portal.garrisons.lk
# Production Compose trusts only the nginx address on its private backend network.
# Override these values if the default subnet overlaps an existing network.
# NGINX_BACKEND_PROXY_SUBNET=172.29.254.0/29
# NGINX_BACKEND_PROXY_IP=172.29.254.2
# NGINX_BACKEND_PROXY_DYNAMIC_RANGE=172.29.254.4/30

# Email and alert delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@garrisons.lk
SMTP_FROM_NAME="Garrisons Investments"
EXCEPTION_EMAIL_RECIPIENTS=admin@garrisons.lk
# Keep true until Grafana alert delivery is validated, then set false in production.
EXCEPTION_EMAIL_ENABLED=true
# To send portal email through useSend, set both variables in the private environment file.
# USESEND_API_URL=https://usesend.example.com/api/v1/emails
# USESEND_API_KEY=
# Optional Cloudflare Email Sending fallback for application mail
# CLOUDFLARE_EMAIL_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_EMAIL_FROM=mailservice@cf-mail.garrisons.lk
# To send Grafana alerts through the same API, also set the three variables below.
# GRAFANA_SMTP_ENABLED=false
# GRAFANA_CONTACT_POINT_FILE=./observability/grafana/contact-points/usesend.yml
# GRAFANA_USESEND_RECIPIENTS_JSON='["admin@example.com","operations@example.com"]'

# Keep automatic audit deletion disabled until D-28-POLICY retention approval is recorded
LOG_PURGE_ENABLED=false

# Structured application logging
LOG_LEVEL=INFO
LOG_HEALTHCHECKS=false
LOG_SOURCE_SERVICE=backend-api
LOG_INSTANCE_ID=

# Self-hosted Grafana, Loki, and Alloy
GRAFANA_DOMAIN=logs.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-admin-password
GRAFANA_DB_PASSWORD=change-this-grafana-database-password
LOKI_MINIO_ACCESS_KEY=loki
LOKI_MINIO_SECRET_KEY=change-this-loki-minio-secret
# Set to the deployment host's socket group from: stat -Lc '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

# Backup settings
# Local development only. Production must use the protected file below.
BACKUP_ENCRYPTION_PASSWORD=change-this-dev-backup-password
# Production keeps this value in a root-owned, mode-0600 file mounted read-only.
# This host path is consumed only by docker-compose.prod.yml.
BACKUP_ENCRYPTION_KEY_HOST_FILE=/opt/garrison-portal/deploy/backup-encryption-key
BACKUP_LOCAL_DIR=/tmp/garrison-backups
BACKUP_RETENTION_DAYS=30
MONTHLY_BACKUP_RETENTION_MONTHS=12

# Async import outbox encryption (decoupled from HR, backup, DB, and MinIO secrets).
# Set a dedicated 32+ byte secret in production; move retired keys to
# IMPORT_OUTBOX_PREVIOUS_ENCRYPTION_KEYS (comma-separated) during approved rotation
# until all queued import outbox rows finish draining.
# IMPORT_OUTBOX_ENCRYPTION_KEY=
# IMPORT_OUTBOX_PREVIOUS_ENCRYPTION_KEYS=
