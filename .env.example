# Application
APP_NAME="Construction Internal Portal"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database
POSTGRES_DB=garrison_portal
POSTGRES_USER=garrison
POSTGRES_PASSWORD=garrison_dev_password
DATABASE_URL=postgresql+asyncpg://garrison:garrison_dev_password@postgres:5432/garrison_portal

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=garrison_minio
MINIO_ROOT_PASSWORD=garrison_minio_password
MINIO_BUCKET=portal-files
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

# JWT signing keys. Required in production/staging: startup fails closed rather than
# falling back to the embedded development key pair.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=24
OTP_EXPIRE_MINUTES=10
ACCOUNT_LOCKOUT_MINUTES=30
AUTH_FAILED_ATTEMPT_LIMIT=3
DEV_EXPOSE_OTP=true
# Staging-only login shortcut for UAT. Ignored unless APP_ENV=staging.
STAGING_LOGIN_OTP=
# Proxies allowed to speak for the client via X-Real-IP / X-Forwarded-For.
# Entries may be single IPs or CIDR subnets. Only list proxies you control: an
# unlisted peer's forwarded headers are ignored and its socket address is used.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Production Compose trusts only the nginx address on its private backend network.
# Override these values if the default subnet overlaps an existing network.
# NGINX_BACKEND_PROXY_SUBNET=172.29.254.0/29
# NGINX_BACKEND_PROXY_IP=172.29.254.2
# NGINX_BACKEND_PROXY_DYNAMIC_RANGE=172.29.254.4/30

# Email and alert delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@garrisons.lk
SMTP_FROM_NAME="Garrisons Investments"
EXCEPTION_EMAIL_RECIPIENTS=admin@garrisons.lk
# Keep true until Grafana alert delivery is validated, then set false in production.
EXCEPTION_EMAIL_ENABLED=true
# To send portal email through useSend, set both variables in the private environment file.
# USESEND_API_URL=https://usesend.example.com/api/v1/emails
# USESEND_API_KEY=
# To send Grafana alerts through the same API, also set the three variables below.
# GRAFANA_SMTP_ENABLED=false
# GRAFANA_CONTACT_POINT_FILE=./observability/grafana/contact-points/usesend.yml
# GRAFANA_USESEND_RECIPIENTS_JSON='["admin@example.com","operations@example.com"]'

# Structured application logging
LOG_LEVEL=INFO
LOG_HEALTHCHECKS=false
LOG_SOURCE_SERVICE=backend-api
LOG_INSTANCE_ID=

# Self-hosted Grafana, Loki, and Alloy
GRAFANA_DOMAIN=logs.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-admin-password
GRAFANA_DB_PASSWORD=change-this-grafana-database-password
LOKI_MINIO_ACCESS_KEY=loki
LOKI_MINIO_SECRET_KEY=change-this-loki-minio-secret
# Numeric group owner of /var/run/docker.sock on the deployment host.
DOCKER_SOCKET_GID=999

# Backup settings
BACKUP_ENCRYPTION_PASSWORD=change-this-dev-backup-password
BACKUP_LOCAL_DIR=/tmp/garrison-backups
BACKUP_RETENTION_DAYS=30
MONTHLY_BACKUP_RETENTION_MONTHS=12
